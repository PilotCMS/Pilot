{
    "name": "tweaker/tweaker",
    "description": "In-app visual tweaker for Laravel with optional DB-backed inline editing",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "tweaker",
        "visual-editor",
        "live-edit"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tweaker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tweaker\\TweakerServiceProvider"
            ]
        }
    }
}
